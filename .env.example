# ===========================================
# WebIntel MCP Configuration
# ===========================================

# SearxNG Host
# Default: Uses the bundled SearxNG container (http://searxng:8080)
# Override: Point to an external SearxNG instance if you have one
# SEARXNG_HOST=http://your-searxng-host:8189
SEARXNG_HOST=http://searxng:8080

# Speech-to-Text (for YouTube transcription)
STT_ENDPOINT=http://localhost:8000/v1
STT_MODEL=Systran/faster-distil-whisper-large-v3
STT_API_KEY=dummy

# ===========================================
# VPN/Proxy Configuration (OPTIONAL)
# ===========================================
# To route requests through a VPN proxy (e.g., gluetun), set PROXY_URL.
# Leave empty or unset to make requests directly without VPN.
#
# Usage with VPN:
#   1. Configure gluetun vars below
#   2. Set PROXY_URL=http://gluetun:8888
#   3. Run: docker compose --profile vpn up -d
#
# Usage without VPN:
#   1. Leave PROXY_URL empty or commented out
#   2. Run: docker compose up -d
#
PROXY_URL=

# ===========================================
# Reddit OAuth (required for Reddit tools)
# ===========================================
# Create a personal-use script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT='python:webintel-mcp:v1.0.0 (by /u/YOUR_REDDIT_USERNAME)'

# Optional. Leave empty to access Reddit directly even when PROXY_URL routes
# other fetchers through a VPN. Reddit often blocks commercial VPN exit nodes.
REDDIT_PROXY_URL=

# Gluetun VPN Configuration (only needed when using --profile vpn)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=openvpn
OPENVPN_USER=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password

# ===========================================
# Cloud Authentication (OPTIONAL)
# ===========================================
# When MCP_AUTHKIT_DOMAIN and MCP_BASE_URL are both set, the server enables
# OAuth 2.1 (WorkOS AuthKit, DCR) for interactive clients, plus an optional
# HMAC-JWT path for headless harnesses (see src/server/auth.py). Leave unset
# to keep the legacy no-auth LAN behavior.
#
# WorkOS AuthKit domain, e.g. https://your-project.authkit.app
MCP_AUTHKIT_DOMAIN=
# Public base URL of this MCP server, e.g. https://mcp.example.com
MCP_BASE_URL=
# Protected-resource URL advertised in OAuth metadata = base URL + mount path.
# Must match the Resource Indicator configured in WorkOS AND the `aud` of
# machine JWTs. Defaults to <MCP_BASE_URL>/mcp.
MCP_RESOURCE_URL=
# Optional: space- or comma-separated scopes required on OAuth tokens.
# MCP_REQUIRED_SCOPES=webintel:read
#
# Headless harnesses: shared HMAC secret for signing/verifying machine JWTs.
# Generate with: python -c 'import secrets;print(secrets.token_urlsafe(48))'
MCP_MACHINE_SECRET=
# Issuer claim expected on machine JWTs (default: webintel-internal)
MCP_MACHINE_ISSUER=webintel-internal
