# Copy to runtime.env, chmod 600, then enter values outside chat/logs.
EXA_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:webintel-mcp:v2
STT_ENDPOINT=
STT_MODEL=
STT_API_KEY=
# Preserve your working routing. Empty YouTube proxy means direct egress.
PROXY_URL=
REDDIT_PROXY_URL=
YOUTUBE_PROXY_URL=
MCP_TRANSPORT=http
# Optional existing authentication configuration; leave absent for current LAN mode.
# MCP_AUTHKIT_DOMAIN=
# MCP_BASE_URL=
# MCP_RESOURCE_URL=
# MCP_MACHINE_SECRET=
# MCP_MACHINE_ISSUER=webintel-internal
# MCP_REQUIRED_SCOPES=
